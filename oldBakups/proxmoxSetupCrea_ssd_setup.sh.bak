#!/usr/bin/env bash -ex
set -euo pipefail
export LVM_SUPPRESS_FD_WARNINGS=1
shopt -s inherit_errexit nullglob

# Color Variables
YW=`echo "\033[33m"`
BL=`echo "\033[36m"`
RD=`echo "\033[01;31m"`
BGN=`echo "\033[4;92m"`
GN=`echo "\033[1;92m"`
DGN=`echo "\033[32m"`
CL=`echo "\033[m"`
BFR="\\r\\033[K"
HOLD="-"
CM="${GN}✓${CL}"
CROSS="${RD}✗${CL}"

echo -e "${YW} This script will Initialize a Disk as LVM-Thin Storage. PVE9 ONLY ${CL}"
while true; do
    read -p "Start the SSD Storage Initialization (Y/n)?" yn
    case $yn in
        ""|"y"|"Y" ) break;;
        [Nn]* ) exit;;
        * ) echo "Please answer yes or no.";;
    esac
done

# Check if the version is 9 or higher
PVE_MAJOR=$(pveversion | cut -d'/' -f2 | cut -d'.' -f1)
if [ "$PVE_MAJOR" -lt 9 ]; then
    echo -e "${RD}This script requires Proxmox Virtual Environment 9.0 or greater.${CL}"
    exit 1
fi

function header_info {
echo -e "${BL}
███████╗███████╗██████╗      ███████╗███████╗████████╗██╗   ██╗██████╗ 
██╔════╝██╔════╝██╔══██╗     ██╔════╝██╔════╝╚══██╔══╝██║   ██║██╔══██╗
███████╗███████╗██║  ██║     ███████╗█████╗     ██║   ██║   ██║██████╔╝
╚════██║╚════██║██║  ██║     ╚════██║██╔══╝     ██║   ██║   ██║██╔═══╝ 
███████║███████║██████╔╝     ███████║███████╗   ██║   ╚██████╔╝██║     
╚══════╝╚══════╝╚═════╝      ╚══════╝╚══════╝   ╚═╝    ╚═════╝ ╚═╝     
${CL}"
}

function msg_info() {
    local msg="$1"
    echo -ne " ${HOLD} ${YW}${msg}..."
}

function msg_ok() {
    local msg="$1"
    echo -e "${BFR} ${CM} ${GN}${msg}${CL}"
}

function msg_error() {
    local msg="$1"
    echo -e "${BFR} ${CROSS} ${RD}${msg}${CL}"
}

clear
header_info

# --- DISK SELECTION LOGIC ---
echo -e "${BL}AVAILABLE DISKS:${CL}"
echo -e "${DGN}"
lsblk -o NAME,SIZE,MODEL,SERIAL,TYPE,MOUNTPOINT | grep -v "loop"
echo -e "${CL}"

read -p "Enter the device name to target (e.g., sdb, nvme1n1): " USER_INPUT
DISK_NAME=$(basename "$USER_INPUT")
DISK="/dev/$DISK_NAME"

# Validate Disk exists and is a block device
if [ ! -b "$DISK" ]; then
    msg_error "Device $DISK not found. Aborting."
    exit 1
fi

echo -e "${RD}!!! WARNING: ALL DATA ON $DISK WILL BE DESTROYED !!!${CL}"
read -p "Type 'CONFIRM' to proceed with wiping $DISK: " FINAL_CHECK
if [ "$FINAL_CHECK" != "CONFIRM" ]; then
    echo "Aborting."
    exit 1
fi

# --- CONFIGURATION ---
VG_NAME="vg_data_ssd"
THINPOOL_NAME="data-ssd"
STORAGE_ID="data-ssd"

# 1. Wipe the disk
msg_info "Wiping disk signatures and GPT on $DISK"
wipefs -a "$DISK" &>/dev/null
sgdisk --zap-all "$DISK" &>/dev/null
sgdisk -o "$DISK" &>/dev/null
msg_ok "Disk $DISK prepared"

# 2. Setup LVM Infrastructure
msg_info "Creating LVM Volume Group: $VG_NAME"
pvcreate -y --force "$DISK" &>/dev/null
vgcreate -y "$VG_NAME" "$DISK" &>/dev/null
msg_ok "Volume Group $VG_NAME created"

# 3. Create Thin Pool
msg_info "Creating LVM-Thin Pool: $THINPOOL_NAME"
lvcreate -y -l 100%FREE --thinpool "$THINPOOL_NAME" "$VG_NAME" &>/dev/null
msg_ok "Thin Pool $THINPOOL_NAME created with ${FREE_SPACE}GB"

# 4. Register in Proxmox
msg_info "Adding $STORAGE_ID to Proxmox Storage System"
pvesm add lvmthin "$STORAGE_ID" \
    --vgname "$VG_NAME" \
    --thinpool "$THINPOOL_NAME" \
    --content rootdir,images &>/dev/null
msg_ok "Storage added successfully"

echo ""
echo -e "${GN}Storage Initialization Finished.${CL}"
echo -e "${BL}Summary of $STORAGE_ID:${CL}"
pvesm status -storage "$STORAGE_ID"
echo ""